# ── 运行期配置（含密钥，切勿提交）──
config.json
legacy/config.json

# ── API Key 明文源（编译期加密前用，绝不提交）──
# secrets.enc 是加密后的密文，安全，需提交；keys.local.json 是明文，禁止提交。
src-tauri/keys.local.json

# ── Node / 前端 ──
node_modules/
dist/
.svelte-kit/
*.log
npm-debug.log*
.DS_Store

# ── Rust / Tauri ──
src-tauri/target/
src-tauri/gen/schemas/

# ── Python 旧版字节码（legacy 目录）──
__pycache__/
*.pyc

# ── 打包产物 ──
build/
*.dmg
*.app
