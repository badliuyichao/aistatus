{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI余额监控",
  "version": "0.1.0",
  "identifier": "com.aistatus.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm sync-version && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI API 余额监控",
        "width": 340,
        "height": 680,
        "minWidth": 300,
        "minHeight": 200,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "hiddenTitle": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
